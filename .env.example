# Copy to .env and fill in. .env is gitignored -- never commit real secrets.

# ---------------------------------------------------------------------------
# CyberFOX AutoElevate Partner API (BETA)
# ---------------------------------------------------------------------------
# Defaults below match the published Partner API reference
# (partner-api-docs.autoelevate.com, spec v1.0.0). The API is still beta, so
# everything stays overridable -- no code change should be needed if it moves.
#
# Create the key in the AutoElevate admin portal with the AE-BEARER scheme and
# the eventView permission/scope. A Service user is recommended for clean audit
# trails. The secret is shown once at creation and cannot be retrieved again.
AE_API_KEY=
AE_BASE_URL=https://partner-api.autoelevate.com
AE_EVENTS_PATH=/api/v1/elevation-events

# bearer -> "Authorization: Bearer <key>"   (what the Partner API uses)
# header -> "<AE_AUTH_HEADER>: <key>"
# query  -> "?<AE_AUTH_HEADER>=<key>"
AE_AUTH_STYLE=bearer
AE_AUTH_HEADER=X-Api-Key

# Pagination / filtering. The API pages with take (max 200) + skip offsets,
# and filters with start/end in epoch milliseconds (AE_SINCE_FORMAT=epoch_ms;
# set to "iso" for an ISO-8601 string instead).
AE_SINCE_PARAM=start
AE_SINCE_FORMAT=epoch_ms
AE_SKIP_PARAM=skip
AE_PAGE_SIZE_PARAM=take
AE_PAGE_SIZE=100
AE_MAX_PAGES=50
AE_TIMEOUT_SECONDS=30

# The beta API requires this header verbatim on every request. Set
# AE_ACK_VALUE to empty to stop sending it once the API leaves beta.
AE_ACK_HEADER=X-Acknowledgment
AE_ACK_VALUE=i-understand-this-is-beta-and-may-change

# ---------------------------------------------------------------------------
# NinjaOne
# ---------------------------------------------------------------------------
# Create an API client in NinjaOne: Administration > Apps > API, with grant
# type "Client Credentials". Region us2 -> us2.ninjarmm.com.
NINJA_REGION=us2
# NINJA_HOST=us2.ninjarmm.com   # overrides NINJA_REGION if your host differs
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=
NINJA_SCOPE=monitoring management

# Where tickets land. Set at least one of these two, or nothing can be filed:
#   NINJA_DEFAULT_ORGANIZATION_ID - fallback org for every event
#   SYNC_ORG_MAP_PATH             - JSON map of AutoElevate company -> org id
NINJA_DEFAULT_ORGANIZATION_ID=
SYNC_ORG_MAP_PATH=

# Ticket defaults. ticket form ids are tenant-specific; leave blank to use the
# tenant default form. Verify the allowed status/priority/severity/type values
# against your NinjaOne ticketing configuration.
NINJA_TICKET_FORM_ID=
NINJA_TICKET_STATUS=NEW
NINJA_TICKET_PRIORITY=MEDIUM
NINJA_TICKET_SEVERITY=MODERATE
NINJA_TICKET_TYPE=PROBLEM
NINJA_TICKET_TAGS=autoelevate
# true makes the description visible to end users in the ticket portal
NINJA_DESCRIPTION_PUBLIC=false
NINJA_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Sync behaviour
# ---------------------------------------------------------------------------
SYNC_STATE_PATH=state.json
SYNC_POLL_INTERVAL_SECONDS=300
SYNC_INITIAL_LOOKBACK_MINUTES=60
SYNC_MAX_EVENTS_PER_RUN=500
SYNC_DEDUPE_HISTORY=5000
SYNC_DRY_RUN=false

# Optional comma-separated allow-lists; empty means "everything".
SYNC_EVENT_TYPES=
SYNC_SEVERITIES=
